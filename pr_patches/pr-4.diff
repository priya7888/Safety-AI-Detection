+
+              <div className="grid grid-cols-3 gap-3">
+                <div>
+                  <span className="text-[10px] text-slate-400 uppercase font-mono">Precursor Signal:</span>
+                  <p className="font-medium text-amber-300 mt-0.5">{safetyIntel.precursor}</p>
